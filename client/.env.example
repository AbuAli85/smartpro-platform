# Copy to .env.local and fill in. Required for Sign In to work on protected routes (e.g. admin/revenue-models).
# For split hosting (Vercel frontend + Railway API) see docs/SPLIT_HOSTING.md.

# OAuth login (required for "Sign In" button and admin access)
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
VITE_APP_ID=your-manus-app-id

# Required when frontend is on a different host than the API (e.g. Vercel + Railway).
# No trailing slash. OAuth callback will use this origin.
VITE_API_URL=https://your-api.example.com
